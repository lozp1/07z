<brls:Box
    id="splashContainer"
    width="100%"
    height="100%"
    axis="column"
    justifyContent="center"
    alignItems="center"
    grow="1.0"
    backgroundColor="#0F1117">

    <brls:Box
        width="auto"
        height="auto"
        axis="column"
        alignItems="center"
        justifyContent="center">

        <brls:Image
            id="splashLogo"
            image="@res/img/07z_logo.png"
            width="170px"
            height="170px"
            cornerRadius="28px" />

        <brls:Label
            id="splashTitle"
            text="07z"
            fontSize="34px"
            textColor="#00E6A8"
            marginTop="18px" />

        <brls:Label
            text="FIFA 07 · Nintendo Switch"
            fontSize="14px"
            textColor="#64748B"
            marginTop="6px" />
    </brls:Box>

    <brls:Box
        positionType="absolute"
        positionBottom="35px"
        positionRight="45px"
        axis="row"
        alignItems="center">
        <brls:ProgressSpinner
            size="normal"
            width="32px"
            height="32px"
            marginRight="12px" />
        <brls:Label
            text="Iniciando..."
            fontSize="14px"
            textColor="#64748B" />
    </brls:Box>

</brls:Box>
