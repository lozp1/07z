<brls:Box
    width="100%"
    height="100%"
    axis="column"
    paddingTop="25px"
    paddingLeft="40px"
    paddingRight="40px"
    paddingBottom="20px"
    backgroundColor="@theme/brls/background">

    <!-- Cabecera: IDENTICA a la de FileZzz (view_explorer.xml): barra de acento
         #00F2FE de 4x22 + titulo 24px + separador de 1px. -->
    <brls:Box
        width="100%"
        height="auto"
        axis="column"
        marginBottom="18px">
        <brls:Box
            width="auto"
            height="auto"
            axis="row"
            alignItems="center"
            marginBottom="12px">
            <brls:Rectangle
                width="4px"
                height="22px"
                color="#00F2FE"
                marginRight="12px" />
            <brls:Label
                text="@i18n/hints/menu_title"
                fontSize="24px"
                textColor="@theme/brls/text" />
        </brls:Box>
        <brls:Box
            width="100%"
            height="1px"
            backgroundColor="@theme/brls/sidebar/separator" />
    </brls:Box>

    <brls:Label
        text="@i18n/hints/menu_subtitle"
        fontSize="14px"
        textColor="@theme/brls/text_disabled"
        marginBottom="12px" />

    <!-- Menu VERTICAL estilo PlayStation (lista de arriba a abajo). Este
         contenedor se rellena en MenuActivity con un CarouselFrame: las cuatro
         opciones (Jugar, Configuracion, Acerca de, Salir) se apilan en columna,
         la enfocada en primer plano (mas grande, sin atenuar) y las de arriba/
         abajo pequenas/atenuadas. Ocupa el espacio central de la pantalla. -->
    <brls:Box
        id="carouselHost"
        width="100%"
        height="auto"
        grow="1.0"
        axis="column"
        alignItems="center"
        justifyContent="center">
    </brls:Box>

    <!-- Pie de ayuda: mismo patron que el footer nativo de FileZzz (iconos de
         boton + texto). Se rellena en MenuActivity (A / B / -). -->
    <brls:Box
        id="menuFooter"
        width="100%"
        height="auto"
        axis="row"
        alignItems="center"
        marginTop="14px" />

</brls:Box>
