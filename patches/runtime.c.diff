+
+/* Roll a detached half's stick to match how it is held: sideways, a Joy-Con
+ * sits ninety degrees from its rail position, so the axes swap and one flips.
+ * A pair in the grip is a dual-mode pad and is left alone, so putting the two
+ * halves back recovers the normal layout with no state to reset.  joycon-rotate
+ * in the keys file turns the roll on (and takes its sign) if a console needs it
+ * beyond its own hold type. */
+static void wine_nx_pad_orient( struct input_pad *raw, u32 style_set, int right )
+{
+    int roll = wine_nx_input_profile.joycon_rotate, x, y;
+
+    if (!roll || !(style_set & (HidNpadStyleTag_NpadJoyLeft | HidNpadStyleTag_NpadJoyRight))) return;
+    if (right) roll = -roll;
+    x = raw->axis[0];
+    y = raw->axis[1];
+    if (roll > 0) { raw->axis[0] = -y; raw->axis[1] = x; }
+    else          { raw->axis[0] = y;  raw->axis[1] = -x; }
 }
 
